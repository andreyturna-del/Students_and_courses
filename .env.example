# ===== Приложение =====
APP_NAME=Students_and_courses
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SERVER_SERVLET_CONTEXT_PATH=/

# ===== Spring Boot =====
SPRING_APPLICATION_NAME=students-and-courses
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ===== База данных (PostgreSQL) =====
POSTGRES_DB=students_courses
POSTGRES_USER=students_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JDBC URL собирается из переменных выше, но можно переопределить целиком
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/students_courses
SPRING_DATASOURCE_USERNAME=students_user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ===== HikariCP (пул соединений) =====
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# ===== JPA / Hibernate =====
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ===== Flyway (миграции) =====
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ===== Безопасность / JWT =====
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Actuator =====
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# ===== Docker Compose =====
COMPOSE_PROJECT_NAME=students_and_courses
